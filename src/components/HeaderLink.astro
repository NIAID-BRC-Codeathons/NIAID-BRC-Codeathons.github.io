---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a"> & { active?: boolean };

const { href, class: className, active, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
const subpath = pathname.match(/[^\/]+/g);
// Header passes `active` when it needs to disambiguate nested routes; fall back
// to first-segment matching for standalone links.
const isActive =
	active ?? (href === pathname || href === "/" + (subpath?.[0] || ""));
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
