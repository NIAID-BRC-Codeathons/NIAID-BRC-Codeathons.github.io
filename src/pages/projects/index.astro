---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Mark from "../../components/Mark.astro";
import {
	EVENT_DATE,
	EVENT_YEAR,
	PROJECT_CHARTER_DEADLINE,
	SITE_TITLE,
} from "../../consts";

const projects = (await getCollection("projects"))
	.filter((p) => p.data.year === 2026)
	.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Projects | ${SITE_TITLE}`}
			description={`The ${projects.length} draft project pitches for the NIAID-BRCs AI Codeathon 2.0, ${EVENT_DATE} at Argonne National Laboratory`}
		/>
		<style>
			main {
				width: 1100px;
				max-width: calc(100% - 2.5em);
				margin: auto;
				padding: 2em 1.25em 5em;
			}

			.page-head {
				display: grid;
				grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
				gap: 3em;
				padding: 3em 0 4em;
				border-bottom: 1px solid var(--rule);
				align-items: end;
			}
			.page-head .head-eyebrow {
				display: flex;
				align-items: center;
				gap: 0.7em;
				color: var(--rust);
			}
			.page-head h1 {
				margin: 0.4em 0 0 0;
				font-size: clamp(2.75rem, 7vw, 5rem);
				font-weight: 100;
				letter-spacing: -0.055em;
				line-height: 1;
			}
			.page-head h1 em {
				font-style: normal;
				color: var(--rust);
				font-weight: 100;
			}
			.page-head .subtitle {
				font-family: var(--font-display);
				font-weight: 300;
				font-size: 1.15rem;
				line-height: 1.5;
				color: var(--ink-soft);
				max-width: 42ch;
				margin-top: 1em;
				letter-spacing: -0.01em;
			}
			.callout {
				background: var(--ink);
				color: var(--paper);
				padding: 1.5em 1.75em;
				border-left: 3px solid var(--rust);
				align-self: end;
			}
			.callout .clabel {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				letter-spacing: 0.22em;
				text-transform: uppercase;
				color: rgba(245, 240, 229, 0.6);
				display: block;
				margin-bottom: 0.5em;
			}
			.callout p {
				margin: 0;
				font-size: 0.95rem;
				color: rgba(245, 240, 229, 0.85);
				line-height: 1.5;
			}
			.callout a {
				color: #f3a76b;
				text-decoration: none;
				border-bottom: 1px solid rgba(243, 167, 107, 0.4);
				transition: border-color 0.2s ease;
			}
			.callout a:hover {
				border-bottom-color: #f3a76b;
			}

			.stat-strip {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 0;
				padding: 2em 0;
				border-bottom: 1px solid var(--rule);
			}
			.stat {
				padding: 0 2em;
				border-right: 1px solid var(--rule);
			}
			.stat:last-child {
				border-right: none;
			}
			.stat:first-child {
				padding-left: 0;
			}
			.stat-label {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				letter-spacing: 0.22em;
				text-transform: uppercase;
				color: var(--mute);
				display: block;
				margin-bottom: 0.4em;
			}
			.stat-value {
				font-family: var(--font-display);
				font-weight: 100;
				font-size: 2.75rem;
				color: var(--ink);
				line-height: 1;
				letter-spacing: -0.055em;
			}
			.stat-sub {
				font-family: var(--font-mono);
				font-size: 0.8rem;
				color: var(--ink-soft);
				margin-top: 0.3em;
			}

			.roster {
				padding: 3.5em 0 0;
			}
			.roster-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1em;
				margin-bottom: 2em;
			}
			.roster-head h2 {
				font-size: 1.25rem;
				font-weight: 500;
				margin: 0;
				font-family: var(--font-display);
				letter-spacing: -0.015em;
			}
			.roster-count {
				font-family: var(--font-mono);
				font-size: 0.78rem;
				letter-spacing: 0.16em;
				text-transform: uppercase;
				color: var(--mute);
			}

			ul.project-list {
				list-style: none;
				margin: 0;
				padding: 0;
				border-top: 1px solid var(--ink);
			}
			ul.project-list li {
				border-bottom: 1px solid var(--rule);
			}
			ul.project-list a {
				display: grid;
				grid-template-columns: 5.5rem minmax(0, 1fr);
				gap: 0 1.5em;
				padding: 1.75em 1.25em 1.75em 0;
				color: inherit;
				text-decoration: none;
				transition: background 0.25s ease;
			}
			ul.project-list a:hover {
				background: var(--paper-deep);
			}
			.proj-num {
				font-family: var(--font-display);
				font-weight: 100;
				font-size: 2.25rem;
				line-height: 1;
				letter-spacing: -0.05em;
				color: var(--mute);
				padding-left: 0.5rem;
				transition: color 0.2s ease;
			}
			ul.project-list a:hover .proj-num {
				color: var(--rust);
			}
			.proj-title {
				font-family: var(--font-display);
				font-size: 1.3rem;
				font-weight: 500;
				color: var(--ink);
				margin: 0 0 0.5em 0;
				letter-spacing: -0.02em;
				line-height: 1.25;
				transition: color 0.2s ease;
			}
			ul.project-list a:hover .proj-title {
				color: var(--rust);
			}
			.proj-desc {
				color: var(--ink-soft);
				font-size: 0.98rem;
				line-height: 1.55;
				margin: 0 0 1em 0;
				max-width: 68ch;
			}
			.proj-foot {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.5em;
			}
			.proj-tag {
				font-family: var(--font-mono);
				font-size: 0.68rem;
				letter-spacing: 0.16em;
				text-transform: uppercase;
				padding: 0.25em 0.7em;
				border: 1px solid var(--rule);
				color: var(--ink-soft);
				border-radius: 2px;
				white-space: nowrap;
			}
			.proj-arrow {
				font-family: var(--font-mono);
				font-size: 0.78rem;
				letter-spacing: 0.16em;
				text-transform: uppercase;
				color: var(--rust);
				margin-left: auto;
				opacity: 0.6;
				transition: opacity 0.2s ease;
			}
			ul.project-list a:hover .proj-arrow {
				opacity: 1;
			}

			.note {
				margin-top: 3em;
				padding: 1.5em 1.75em;
				border-left: 2px solid var(--teal);
				background: var(--paper-soft);
			}
			.note .label {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				letter-spacing: 0.22em;
				text-transform: uppercase;
				color: var(--teal);
				display: block;
				margin-bottom: 0.5em;
			}
			.note p {
				margin: 0 0 0.9em 0;
				color: var(--ink-soft);
				font-size: 0.95rem;
				line-height: 1.6;
				max-width: 72ch;
			}
			.note p:last-child {
				margin-bottom: 0;
			}
			.note a {
				color: var(--rust);
				text-decoration: none;
				border-bottom: 1px solid rgba(184, 69, 31, 0.35);
				transition: border-color 0.2s ease;
			}
			.note a:hover {
				border-bottom-color: var(--rust);
			}

			@media (max-width: 820px) {
				.page-head,
				.stat-strip {
					grid-template-columns: 1fr;
					gap: 1.5em;
				}
				.stat {
					padding: 1em 0;
					border-right: none;
					border-bottom: 1px solid var(--rule);
				}
				.stat:last-child {
					border-bottom: none;
				}
				ul.project-list a {
					grid-template-columns: 1fr;
					gap: 0.5em;
					padding: 1.5em 0;
				}
				.proj-num {
					padding-left: 0;
					font-size: 1.5rem;
				}
				.proj-arrow {
					margin-left: 0;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-head">
				<div>
					<div class="head-eyebrow">
						<Mark size={12} color="var(--rust)" variant="node" />
						<span class="eyebrow">Draft pitches · {EVENT_YEAR}</span>
					</div>
					<h1>
						Projects<em>.</em>
					</h1>
					<p class="subtitle">
						Starting points for the NIAID-BRCs AI Codeathon 2.0, {EVENT_DATE} at Argonne
						National Laboratory — sketched by the organizing team, to be developed
						by the teams that take them on.
					</p>
				</div>
				<div class="callout">
					<span class="clabel">Read these as drafts</span>
					<p>
						Each entry below is a one-slide pitch — enough to form balanced
						teams around, and no more. Scope, methods, and success criteria are
						all still open. Teams develop them into full project charters by {
							PROJECT_CHARTER_DEADLINE
						}.
					</p>
				</div>
			</section>

			<section class="stat-strip">
				<div class="stat">
					<span class="stat-label">Projects</span>
					<div class="stat-value">{projects.length}</div>
					<div class="stat-sub">pitches to develop</div>
				</div>
				<div class="stat">
					<span class="stat-label">Days on site</span>
					<div class="stat-value">3</div>
					<div class="stat-sub">Sep 16 — 18, 2026</div>
				</div>
				<div class="stat">
					<span class="stat-label">Venue</span>
					<div class="stat-value">ANL</div>
					<div class="stat-sub">Argonne National Lab</div>
				</div>
			</section>

			<section class="roster">
				<div class="roster-head">
					<h2>The {EVENT_YEAR} slate</h2>
					<span class="roster-count">
						{String(projects.length).padStart(2, "0")} projects
					</span>
				</div>
				<ul class="project-list">
					{
						projects.map((project) => (
							<li>
								<a href={`/projects/${project.id}/`}>
									<div class="proj-num">
										{String(project.data.order ?? 0).padStart(2, "0")}
									</div>
									<div>
										<h3 class="proj-title">{project.data.title}</h3>
										<p class="proj-desc">{project.data.description}</p>
										<div class="proj-foot">
											{(project.data.tags ?? []).slice(0, 3).map((tag) => (
												<span class="proj-tag">{tag}</span>
											))}
											<span class="proj-arrow">Read more →</span>
										</div>
									</div>
								</a>
							</li>
						))
					}
				</ul>

				<aside class="note">
					<span class="label">What happens next</span>
					<p>
						These pitches exist to give teams something concrete to argue with.
						Expect them to change substantially — narrowing the organism or
						dataset, replacing the proposed method, cutting the three-day scope
						down to something that actually ships, or reframing the question
						altogether. That work belongs to the team, and lands in the project
						charter due {PROJECT_CHARTER_DEADLINE}.
					</p>
					<p>
						Team assignments are still being finalized; participants can review
						their project and request a reassignment through the participant
						spreadsheet circulated by the organizing team. For a sense of what a
						finished project looks like, see the
						<a href="/projects/2025/">2025 archive</a>.
					</p>
				</aside>
			</section>
		</main>
		<Footer />
	</body>
</html>
